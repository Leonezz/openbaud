#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/openbaud-plugin-smoke.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM

request_file="$test_root/requests.jsonl"
response_file="$test_root/responses.jsonl"

python3 - "$plugin_root/.mcp.json" <<'PY'
import json
import pathlib
import sys

server = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["mcpServers"]["openbaud"]
if server.get("command") != "node":
    raise SystemExit("plugin MCP must use the portable Node launcher")
if server.get("args") != ["./launcher.mjs", "mcp"]:
    raise SystemExit("plugin MCP must launch launcher.mjs with args [mcp]")
if server.get("cwd") != ".":
    raise SystemExit("plugin MCP cwd must resolve relative to the plugin root")
PY

python3 - "$request_file" "$plugin_root/.codex-plugin/plugin.json" <<'PY'
import json
import pathlib
import sys

version = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))["version"]
requests = [
    {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
            "protocolVersion": "2025-06-18",
            "capabilities": {},
            "clientInfo": {"name": "openbaud-plugin-smoke", "version": version},
        },
    },
    {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
    {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    {"jsonrpc": "2.0", "id": 3, "method": "resources/list", "params": {}},
    {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "resources/read",
        "params": {"uri": "ui://openbaud/port-picker.html"},
    },
    {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "resources/read",
        "params": {"uri": "ui://openbaud/viewer.html"},
    },
]
pathlib.Path(sys.argv[1]).write_text(
    "\n".join(json.dumps(item) for item in requests) + "\n",
    encoding="utf-8",
)
PY

(
  cd "$plugin_root"
  env PWD="$test_root" node ./launcher.mjs mcp < "$request_file" > "$response_file"
)

python3 - "$response_file" "$test_root" "$plugin_root/.codex-plugin/plugin.json" <<'PY'
import json
import pathlib
import sys

responses = [
    json.loads(line)
    for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
]
by_id = {item.get("id"): item for item in responses}

server = by_id[1]["result"]["serverInfo"]
tools = by_id[2]["result"]["tools"]
resources = by_id[3]["result"]["resources"]
manifest = json.loads(pathlib.Path(sys.argv[3]).read_text(encoding="utf-8"))
mcp_config = json.loads(
    pathlib.Path(sys.argv[3]).parents[1].joinpath(".mcp.json").read_text(encoding="utf-8")
)
names = {tool["name"] for tool in tools}
required = {
    "list_ports",
    "open",
    "close",
    "read",
    "send",
    "request",
    "run_command",
    "run_workflow",
    "schema",
    "capture_start",
    "capture_stop",
    "session_timeline",
    "capture_frames",
    "diagnose_frame",
    "session_stats",
    "stream_poll",
    "ask_port",
    "show_result",
}

if server["name"] != "openbaud":
    raise SystemExit(f"unexpected server: {server}")
if server["version"] != manifest["version"]:
    raise SystemExit(
        f"runtime version {server['version']} does not match plugin {manifest['version']}"
    )
server_config = mcp_config["mcpServers"]["openbaud"]
if server_config.get("cwd") != ".":
    raise SystemExit("plugin MCP cwd must resolve relative to the plugin root")
if server_config.get("command") != "node":
    raise SystemExit("plugin MCP must use the portable Node launcher")
if server_config.get("args") != ["./launcher.mjs", "mcp"]:
    raise SystemExit("plugin MCP must launch launcher.mjs with args [mcp]")
if names != required:
    raise SystemExit(f"unexpected tools: {sorted(names)}")

by_name = {tool["name"]: tool for tool in tools}
ui_bindings = {
    "ask_port": "ui://openbaud/port-picker.html",
    "show_result": "ui://openbaud/viewer.html",
}
for name, uri in ui_bindings.items():
    actual = by_name[name].get("_meta", {}).get("ui", {}).get("resourceUri")
    if actual != uri:
        raise SystemExit(f"{name} UI binding is {actual!r}, expected {uri!r}")

resource_by_uri = {resource["uri"]: resource for resource in resources}
if set(resource_by_uri) != set(ui_bindings.values()):
    raise SystemExit(f"unexpected UI resources: {sorted(resource_by_uri)}")
for uri, resource in resource_by_uri.items():
    if resource.get("mimeType") != "text/html;profile=mcp-app":
        raise SystemExit(f"{uri} has unexpected MIME type: {resource.get('mimeType')!r}")

for response_id, uri in ((4, ui_bindings["ask_port"]), (5, ui_bindings["show_result"])):
    contents = by_id[response_id]["result"].get("contents", [])
    if len(contents) != 1:
        raise SystemExit(f"{uri} returned {len(contents)} content blocks, expected 1")
    content = contents[0]
    if content.get("uri") != uri or content.get("mimeType") != "text/html;profile=mcp-app":
        raise SystemExit(f"{uri} returned invalid resource metadata: {content}")
    html = content.get("text")
    if not isinstance(html, str) or not html.lower().startswith("<!doctype html>"):
        raise SystemExit(f"{uri} did not return a self-contained HTML document")

for tool in tools:
    annotations = tool.get("annotations", {})
    missing = {
        hint
        for hint in ("readOnlyHint", "openWorldHint", "destructiveHint")
        if not isinstance(annotations.get(hint), bool)
    }
    if missing:
        raise SystemExit(f"{tool['name']} has invalid annotations: {sorted(missing)}")

for name in ("send", "request", "run_command", "run_workflow"):
    if not by_name[name]["annotations"]["destructiveHint"]:
        raise SystemExit(f"{name} must declare destructiveHint=true")

for name in ("list_ports", "open", "close", "read", "send", "request", "run_command", "run_workflow"):
    if not by_name[name]["annotations"]["openWorldHint"]:
        raise SystemExit(f"{name} must declare openWorldHint=true")

test_root = pathlib.Path(sys.argv[2])
if not (test_root / ".openbaud").is_dir():
    raise SystemExit("MCP runtime did not use the inherited working directory")

print(f"openbaud {server['version']}: {len(tools)} MCP tools; workspace cwd verified")
PY
