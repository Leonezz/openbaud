#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

kernel=$(uname -s 2>/dev/null || printf unknown)
machine=$(uname -m 2>/dev/null || printf unknown)

case "$kernel:$machine" in
  Darwin:arm64)
    bundled_binary="$plugin_root/bin/darwin-arm64/openbaud"
    ;;
  Darwin:x86_64)
    bundled_binary="$plugin_root/bin/darwin-x64/openbaud"
    ;;
  Linux:x86_64)
    bundled_binary="$plugin_root/bin/linux-x64/openbaud"
    ;;
  Linux:aarch64|Linux:arm64)
    bundled_binary="$plugin_root/bin/linux-arm64/openbaud"
    ;;
  MINGW*:x86_64|MSYS*:x86_64|CYGWIN*:x86_64)
    bundled_binary="$plugin_root/bin/windows-x64/openbaud.exe"
    ;;
  *)
    bundled_binary=
    ;;
esac

if [ -n "$bundled_binary" ] && [ -x "$bundled_binary" ]; then
  exec "$bundled_binary" "$@"
fi

# This fallback keeps source checkouts useful before a bundled runtime has
# been built. Published plugin artifacts are expected to include the binary.
if installed_binary=$(command -v openbaud 2>/dev/null); then
  case "$installed_binary" in
    /*) exec "$installed_binary" "$@" ;;
  esac
fi

printf '%s\n' \
  "OpenBaud could not start: no bundled runtime for $kernel/$machine." \
  "Reinstall the plugin, or install the openbaud CLI and make it available on PATH." >&2
exit 127
